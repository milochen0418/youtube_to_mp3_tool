# Environment variables for YouTube to MP3 (all optional)

# Conversions at the same time (1-8; default 3)
# YT2MP3_PARALLEL=3

# Where downloads wait to be converted (default: the system temp folder)
# YT2MP3_WORK_DIR=/path/to/work

# The shared collection tree and this app's owner name (set by the App Store).
# Run on a laptop without them, the app writes to /Users/Shared/re-ddns/collections on macOS.
# DDNS_COLLECTIONS_ROOT=/tmp/collections
# DDNS_APP_ID=youtube-to-mp3
